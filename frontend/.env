import React, { useState, useEffect, useMemo } from 'react';
import { Search, User, Lock, AlertCircle, Loader2, RefreshCw, Database, XCircle, CheckCircle2, Clock, Wifi, WifiOff, Bell, LogOut, Eye, EyeOff } from 'lucide-react';

export default function App() {
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [loginData, setLoginData] = useState({ userid: '', pwd: '' });
  const [loginLoading, setLoginLoading] = useState(false);
  const [loginError, setLoginError] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [token, setToken] = useState(null);
  const [rememberMe, setRememberMe] = useState(true);
  const [isInitializing, setIsInitializing] = useState(true);
  const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);
  const [isLandscape, setIsLandscape] = useState(window.innerWidth > window.innerHeight);
  const [allUsers, setAllUsers] = useState([]);
  const [searchQuery, setSearchQuery] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [selectedUser, setSelectedUser] = useState(null);
  const [lastFetch, setLastFetch] = useState(null);
  const [copiedField, setCopiedField] = useState('');
  const [showSyncOverlay, setShowSyncOverlay] = useState(false);
  const [autoSync, setAutoSync] = useState(true);
  const [syncCountdown, setSyncCountdown] = useState(300);
  const [isSyncing, setIsSyncing] = useState(false);
  const [hasNewData, setHasNewData] = useState(false);
  const [kickingUser, setKickingUser] = useState(null);

  const API_URL = import.meta.env.VITE_API_URL || 'http://192.168.71.106:3010';
  const SYNC_INTERVAL = 5 * 60 * 1000;

  // Khôi phục session
  useEffect(() => {
    const initAuth = () => {
      setIsInitializing(true);
      
      try {
        const savedToken = localStorage.getItem('auth_token');
        const savedUserid = localStorage.getItem('auth_userid');
        
        if (savedToken && savedUserid) {
          console.log('🔐 Restoring session...');
          setToken(savedToken);
          setLoginData(prev => ({ ...prev, userid: savedUserid }));
          setIsLoggedIn(true);
          
          // Sync ngầm sau khi restore
          setTimeout(() => {
            loadAllUsers(true, savedToken);
          }, 200);
        }
      } catch (err) {
        console.error('❌ Failed to restore session:', err);
      } finally {
        setIsInitializing(false);
      }
    };

    initAuth();
  }, []);

  const saveAuth = (token, userid) => {
    if (rememberMe) {
      try {
        localStorage.setItem('auth_token', token);
        localStorage.setItem('auth_userid', userid);
      } catch (err) {
        console.error('Failed to save auth:', err);
      }
    }
  };

  const clearAuth = () => {
    try {
      localStorage.removeItem('auth_token');
      localStorage.removeItem('auth_userid');
    } catch (err) {
      console.error('Failed to clear auth:', err);
    }
  };

  useEffect(() => {
    const handleResize = () => {
      setIsMobile(window.innerWidth <= 768);
      setIsLandscape(window.innerWidth > window.innerHeight);
    };
    window.addEventListener('resize', handleResize);
    window.addEventListener('orientationchange', handleResize);
    return () => {
      window.removeEventListener('resize', handleResize);
      window.removeEventListener('orientationchange', handleResize);
    };
  }, []);

  const handleLogin = async (e) => {
    e.preventDefault();
    setLoginLoading(true);
    setLoginError('');

    try {
      const response = await fetch(`${API_URL}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(loginData)
      });

      const data = await response.json();

      if (data.success) {
        setToken(data.data.token);
        setIsLoggedIn(true);
        saveAuth(data.data.token, loginData.userid);
        
        // Sync ngầm
        loadAllUsers(true, data.data.token);
      } else {
        setLoginError(data.message || 'Đăng nhập thất bại');
      }
    } catch (err) {
      setLoginError('Không thể kết nối đến máy chủ');
    } finally {
      setLoginLoading(false);
    }
  };

  const handleLogout = () => {
    setIsLoggedIn(false);
    setToken(null);
    setLoginData({ userid: '', pwd: '' });
    setAllUsers([]);
    setSearchQuery('');
    setLastFetch(null);
    clearAuth();
  };

  useEffect(() => {
    if (!autoSync || !isLoggedIn || !token || allUsers.length === 0) return;
    const syncTimer = setInterval(() => {
      loadAllUsers(false, token);
    }, SYNC_INTERVAL);
    return () => clearInterval(syncTimer);
  }, [autoSync, isLoggedIn, token, allUsers.length]);

  useEffect(() => {
    if (!autoSync || !isLoggedIn || allUsers.length === 0) return;
    const countdownTimer = setInterval(() => {
      setSyncCountdown(prev => prev <= 1 ? 300 : prev - 1);
    }, 1000);
    return () => clearInterval(countdownTimer);
  }, [autoSync, isSyncing, isLoggedIn, allUsers.length]);

  const loadAllUsers = async (showLoading = true, authToken = null) => {
    const currentToken = authToken || token;
    if (!currentToken) {
      console.log('❌ No token available');
      return;
    }
    
    if (isSyncing && !showLoading) return;
    
    console.log('🔄 Starting sync...', { showLoading, hasToken: !!currentToken });
    
    if (showLoading) setLoading(true);
    setIsSyncing(true);
    if (showLoading) setShowSyncOverlay(true);
    setError(null);
    setHasNewData(false);

    // Timeout 30s
    const timeoutId = setTimeout(() => {
      console.error('⏱️ Timeout 30s');
      setLoading(false);
      setIsSyncing(false);
      setShowSyncOverlay(false);
      setError('Timeout: Không thể kết nối máy chủ sau 30 giây');
    }, 30000);

    try {
      const url = `${API_URL}/api/users/all?force=${showLoading ? 1 : 0}`;
      console.log('📡 Fetching:', url);
      
      const response = await fetch(url, {
        cache: 'no-store',
        headers: { 'Authorization': `Bearer ${currentToken}` }
      });

      const data = await response.json();
      console.log('✅ Response:', data.success ? 'Success' : 'Failed');

      if (data.success) {
        const isNewData = allUsers.length > 0 && (allUsers.length !== data.data.users.length);
        setAllUsers(data.data.users);
        setLastFetch(data.data.lastFetch);
        if (!showLoading) setSyncCountdown(300);
        if (isNewData && !showLoading) {
          setHasNewData(true);
          setTimeout(() => setHasNewData(false), 5000);
        }
      } else {
        console.error('❌ API Error:', data.message);
        setError(data.message || 'Không thể tải dữ liệu');
        
        if (data.message?.includes('token') || data.message?.includes('unauthorized')) {
          handleLogout();
        }
      }
    } catch (err) {
      console.error('❌ Fetch Error:', err);
      setError(`Không thể kết nối máy chủ: ${err.message}`);
    } finally {
      clearTimeout(timeoutId);
      console.log('🏁 Sync complete - cleaning up states');
      setLoading(false);
      setIsSyncing(false);
      setShowSyncOverlay(false);
    }
  };

  const handleManualSync = () => {
    loadAllUsers(true, token);
  };

  const handleKickWifi = async (username) => {
    if (!window.confirm(`Xác nhận KÍCH WiFi ${username}?`)) return;
    setKickingUser(username);

    try {
      const res = await fetch(`${API_URL}/api/mikrotik/kick`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ username }),
      });

      const data = await res.json();

      if (data.success) {
        alert('✅ Đã kích WiFi');
      } else {
        alert(data.message || '❌ Thất bại kích WiFi');
      }
    } catch (err) {
      alert('❌ Không thể kết nối máy chủ');
    } finally {
      setKickingUser(null);
    }
  };

  const copyToClipboard = (text, field) => {
    navigator.clipboard.writeText(text);
    setCopiedField(field);
    setTimeout(() => setCopiedField(''), 2000);
  };

  const formatCountdown = (seconds) => {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  };

  const filteredUsers = useMemo(() => {
    if (!searchQuery.trim()) return [];
    const query = searchQuery.toLowerCase();
    return allUsers.filter(user =>
      user.username?.toLowerCase().includes(query) ||
      user.displayName?.toLowerCase().includes(query) ||
      user.description?.toLowerCase().includes(query) ||
      user.email?.toLowerCase().includes(query) ||
      user.department?.toLowerCase().includes(query)
    ).slice(0, 50);
  }, [searchQuery, allUsers]);

  const DetailCard = ({ label, value, icon }) => {
    if (!value) return null;
    return (
      <div style={styles.detailCard}>
        <div style={styles.detailLabel}>
          <span style={{ marginRight: '6px' }}>{icon}</span>
          {label}
        </div>
        <p style={styles.detailValue}>{value}</p>
      </div>
    );
  };

  if (isInitializing) {
    return (
      <div style={styles.loadingContainer}>
        <div style={styles.loadingCard}>
          <div style={styles.syncSpinner} />
          <h2 style={styles.syncTitle}>Đang khởi tạo...</h2>
          <p style={styles.syncText}>Vui lòng chờ</p>
        </div>
      </div>
    );
  }

  if (!isLoggedIn) {
    return (
      <div style={styles.loginContainer}>
        <div style={isLandscape ? styles.loginCardLandscape : styles.loginCard}>
          <div style={styles.loginHeader}>
            <div style={styles.loginIconWrapper}>
              <Database style={styles.loginIcon} />
            </div>
            <h1 style={isLandscape ? styles.loginTitleLandscape : styles.loginTitle}>
              Tìm kiếm người dùng Domain
            </h1>
          </div>

          <form onSubmit={handleLogin} style={styles.loginForm}>
            <div style={styles.inputGroup}>
              <label style={styles.inputLabel}>
                <User style={styles.inputIcon} />
                Tên đăng nhập
              </label>
              <input
                type="text"
                value={loginData.userid}
                onChange={(e) => setLoginData({...loginData, userid: e.target.value})}
                placeholder="Nhập username"
                style={styles.input}
                disabled={loginLoading}
                autoFocus
              />
            </div>

            <div style={styles.inputGroup}>
              <label style={styles.inputLabel}>
                <Lock style={styles.inputIcon} />
                Mật khẩu
              </label>
              <div style={styles.passwordWrapper}>
                <input
                  type={showPassword ? 'text' : 'password'}
                  value={loginData.pwd}
                  onChange={(e) => setLoginData({...loginData, pwd: e.target.value})}
                  placeholder="Nhập mật khẩu"
                  style={styles.input}
                  disabled={loginLoading}
                />
                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  style={styles.eyeButton}
                  disabled={loginLoading}
                >
                  {showPassword ? <EyeOff size={20} /> : <Eye size={20} />}
                </button>
              </div>
            </div>

            <div style={styles.rememberBox}>
              <label style={styles.rememberLabel}>
                <input
                  type="checkbox"
                  checked={rememberMe}
                  onChange={(e) => setRememberMe(e.target.checked)}
                  style={styles.checkbox}
                />
                <span>Ghi nhớ</span>
              </label>
            </div>

            {loginError && (
              <div style={styles.loginError}>
                <AlertCircle style={styles.errorIcon} />
                <span>{loginError}</span>
              </div>
            )}

            <button
              type="submit"
              style={styles.loginButton}
              disabled={loginLoading || !loginData.userid || !loginData.pwd}
            >
              {loginLoading ? (
                <>
                  <Loader2 style={{...styles.buttonIcon, animation: 'spin 1s linear infinite'}} />
                  Đang đăng nhập...
                </>
              ) : (
                <>
                  <Lock style={styles.buttonIcon} />
                  Đăng nhập
                </>
              )}
            </button>
          </form>
        </div>
      </div>
    );
  }

  if (loading && allUsers.length === 0) {
    return (
      <div style={styles.syncOverlay}>
        <div style={styles.syncCard}>
          <div style={styles.syncSpinner} />
          <h2 style={styles.syncTitle}>Đang đồng bộ dữ liệu Domain</h2>
          <p style={styles.syncText}>Vui lòng chờ trong giây lát…</p>
          <p style={styles.syncSub}>⏳ Thời gian có thể từ 10 – 30 giây</p>
        </div>
      </div>
    );
  }

  if (error && allUsers.length === 0) {
    return (
      <div style={styles.loadingContainer}>
        <div style={{...styles.loadingCard, ...styles.errorCard}}>
          <XCircle style={{...styles.loadingIcon, color: '#ef4444'}} />
          <h2 style={styles.errorTitle}>Lỗi kết nối Domain</h2>
          <p style={styles.errorText}>{error}</p>
          <button onClick={() => loadAllUsers(true, token)} style={styles.errorButton}>
            Thử lại
          </button>
        </div>
      </div>
    );
  }

  return (
    <div style={styles.container}>
      <div style={styles.wrapper}>
        {hasNewData && (
          <div style={styles.notification}>
            <Bell style={styles.notificationIcon} />
            <span>🎉 Có dữ liệu mới từ domain!</span>
          </div>
        )}

        {showSyncOverlay && (
          <div style={styles.syncOverlay}>
            <div style={styles.syncCard}>
              <div style={styles.syncSpinner} />
              <h2 style={styles.syncTitle}>Đang đồng bộ...</h2>
              <p style={styles.syncText}>Vui lòng chờ</p>
            </div>
          </div>
        )}

        <div style={styles.header}>
          <div style={isMobile ? styles.headerContentMobile : styles.headerContent}>
            <div style={styles.headerLeft}>
              <div style={styles.iconWrapper}>
                <Database style={styles.headerIcon} />
              </div>
              <div>
                <h1 style={styles.title}>Tìm kiếm người dùng Domain</h1>
                <p style={styles.subtitle}>Tìm kiếm {allUsers.length} người dùng</p>
              </div>
            </div>
            {!isMobile && (
              <button onClick={handleLogout} style={styles.logoutButton}>
                <LogOut size={18} />
                <span>Đăng xuất</span>
              </button>
            )}
          </div>
        </div>

        <div style={isLandscape ? styles.statsBarLandscape : styles.statsBar}>
          <div style={styles.statItem}>
            <User style={styles.statIcon} />
            <div>
              <div style={styles.statLabel}>Người dùng</div>
              <div style={styles.statValue}>{allUsers.length}</div>
            </div>
          </div>
          <div style={styles.statDivider} />
          <div style={styles.statItem}>
            {autoSync ? 
              <Wifi style={{...styles.statIcon, color: '#10b981'}} /> : 
              <WifiOff style={{...styles.statIcon, color: '#f59e0b'}} />
            }
            <div>
              <div style={styles.statLabel}>{autoSync ? 'Tự động BẬT' : 'Tự động TẮT'}</div>
              {autoSync && (
                <div style={styles.countdown}>
                  <Clock size={14} style={{marginRight: '4px'}} />
                  {formatCountdown(syncCountdown)}
                </div>
              )}
            </div>
          </div>

          <div style={styles.statDivider} />

          {!isMobile && lastFetch && (
            <div style={styles.statItem}>
              <Clock style={styles.statIcon} />
              <div>
                <div style={styles.statLabel}>Cập nhật</div>
                <div style={styles.statTime}>{lastFetch}</div>
              </div>
            </div>
          )}

          <div style={styles.statsActions}>
            <button
              onClick={() => setAutoSync(!autoSync)}
              style={{
                ...styles.actionButton,
                background: autoSync ? '#10b981' : '#f59e0b'
              }}
            >
              {autoSync ? <Wifi size={16} /> : <WifiOff size={16} />}
            </button>
            <button 
              onClick={handleManualSync} 
              style={{...styles.actionButton, background: '#0ea5e9'}} 
              disabled={isSyncing}
            >
              <RefreshCw
                size={16}
                style={{animation: isSyncing ? 'spin 1s linear infinite' : 'none'}}
              />
            </button>
          </div>
        </div>

        <div style={styles.searchBox}>
          <Search style={styles.searchIcon} />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder={`Tìm kiếm trong ${allUsers.length} người dùng...`}
            style={styles.searchInput}
          />
          {searchQuery && (
            <button onClick={() => setSearchQuery('')} style={styles.clearButton}>
              <XCircle size={20} />
            </button>
          )}
        </div>

        {searchQuery && (
          <div style={styles.searchInfo}>
            Tìm thấy <span style={styles.searchCount}>{filteredUsers.length}</span> kết quả
          </div>
        )}

        {searchQuery && filteredUsers.length > 0 && (
          <div style={{
            ...(isLandscape ? styles.gridLandscape : styles.grid),
            gridTemplateColumns: isMobile ? '1fr' : 'repeat(auto-fill, minmax(280px, 1fr))'
          }}>
            {filteredUsers.map((user, index) => (
              <div key={index} style={styles.card} onClick={() => setSelectedUser(user)}>
                <div style={styles.cardHeader}>
                  <div style={styles.cardIconBox}>
                    <User size={20} color="#fff" />
                  </div>
                  <div style={styles.cardInfo}>
                    <h3 style={styles.cardTitle}>{user.username}</h3>
                    <p style={styles.cardSubtitle}>{user.displayName || 'Không có tên'}</p>
                  </div>
                  <button
                    onClick={(e) => {
                      e.stopPropagation();
                      handleKickWifi(user.username);
                    }}
                    disabled={kickingUser === user.username}
                    style={styles.kickButton}
                  >
                    {kickingUser === user.username ? (
                      <Loader2 size={14} style={{ animation: 'spin 1s linear infinite' }} />
                    ) : (
                      <WifiOff size={14} />
                    )}
                    KÍCH
                  </button>
                </div>

                {user.description && (
                  <div style={styles.cardPasswordBox}>
                    <div style={styles.cardPasswordHeader}>
                      <Lock style={styles.cardPasswordIcon} />
                      <span style={styles.cardPasswordLabel}>MẬT KHẨU</span>
                    </div>
                    <p style={styles.cardPasswordText}>{user.description}</p>
                  </div>
                )}

                <div style={styles.cardDetails}>
                  {user.email && <span>📧 {user.email}</span>}
                  {user.department && <span>🏢 {user.department}</span>}
                </div>
              </div>
            ))}
          </div>
        )}

        {searchQuery && filteredUsers.length === 0 && (
          <div style={styles.noResults}>
            <AlertCircle size={48} color="#94a3b8" />
            <p>Không tìm thấy kết quả cho "{searchQuery}"</p>
          </div>
        )}

        {!searchQuery && !isLandscape && (
          <div style={styles.welcome}>
            <Search size={64} color="#0ea5e9" />
            <h3 style={styles.welcomeTitle}>Bắt đầu tìm kiếm</h3>
            <p style={styles.welcomeText}>Nhập username, tên, email hoặc phòng ban</p>
          </div>
        )}

        {isMobile && (
          <button onClick={handleLogout} style={styles.mobileLogoutButton}>
            <LogOut size={18} />
            <span>Đăng xuất</span>
          </button>
        )}
      </div>

      {selectedUser && (
        <div style={styles.modalOverlay} onClick={() => setSelectedUser(null)}>
          <div style={isLandscape ? styles.modalLandscape : styles.modal} onClick={(e) => e.stopPropagation()}>
            <div style={styles.modalHeader}>
              <div style={styles.modalHeaderLeft}>
                <div style={styles.modalIconBox}>
                  <User color="#fff" />
                </div>
                <div>
                  <h2 style={styles.modalTitle}>{selectedUser.username}</h2>
                  <p style={styles.modalSubtitle}>{selectedUser.displayName || 'Không có tên'}</p>
                </div>
              </div>
              <button style={styles.closeButton} onClick={() => setSelectedUser(null)}>
                <XCircle />
              </button>
            </div>

            <div style={isLandscape ? styles.modalContentLandscape : styles.modalContent}>
              {selectedUser.description && (
                <div style={styles.modalPassword}>
                  <div style={styles.modalPasswordHeader}>
                    <div style={styles.modalPasswordTitle}>
                      <Lock size={14} /> Mật khẩu
                    </div>
                    <button onClick={() => copyToClipboard(selectedUser.description, 'password')} style={styles.copyButton}>
                      {copiedField === 'password' ? (
                        <>
                          <CheckCircle2 size={14} />
                          Đã copy
                        </>
                      ) : 'Copy'}
                    </button>
                  </div>
                  <div style={styles.modalPasswordValue}>
                    {selectedUser.description}
                  </div>
                </div>
              )}

              <div style={isLandscape ? styles.modalGridLandscape : styles.modalGrid}>
                <DetailCard label="Email" value={selectedUser.email} icon="📧" />
                <DetailCard label="Chức vụ" value={selectedUser.title} icon="💼" />
                <DetailCard label="Phòng ban" value={selectedUser.department} icon="🏢" />
                <DetailCard label="Công ty" value={selectedUser.company} icon="🏛️" />
                <DetailCard label="Điện thoại" value={selectedUser.phone} icon="☎️" />
                <DetailCard label="Di động" value={selectedUser.mobile} icon="📱" />
              </div>
            </div>
          </div>
        </div>
      )}

      <style>{`
        @keyframes spin {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
      `}</style>
    </div>
  );
}

const styles = {
  loginContainer: {
    minHeight: '100vh',
    background: 'linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%)',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    padding: '1rem',
  },
  loginCard: {
    background: 'white',
    borderRadius: '1.5rem',
    padding: '2.5rem',
    maxWidth: '420px',
    width: '100%',
    boxShadow: '0 10px 40px rgba(0, 0, 0, 0.1)',
  },
  loginCardLandscape: {
    background: 'white',
    borderRadius: '1rem',
    padding: '1.5rem 2rem',
    maxWidth: '600px',
    width: '100%',
    boxShadow: '0 10px 40px rgba(0, 0, 0, 0.1)',
  },
  loginHeader: {
    textAlign: 'center',
    marginBottom: '2rem',
  },
  loginIconWrapper: {
    display: 'inline-flex',
    alignItems: 'center',
    justifyContent: 'center',
    width: '4rem',
    height: '4rem',
    background: 'linear-gradient(135deg, #0ea5e9 0%, #06b6d4 100%)',
    borderRadius: '1rem',
    marginBottom: '1rem',
  },
  loginIcon: {
    width: '2rem',
    height: '2rem',
    color: 'white',
  },
  loginTitle: {
    fontSize: '2rem',
    fontWeight: 'bold',
    color: '#0c4a6e',
    marginBottom: '0.5rem',
  },
  loginTitleLandscape: {
    fontSize: '1.5rem',
    fontWeight: 'bold',
    color: '#0c4a6e',
    marginBottom: '0.5rem',
  },
  loginForm: {
    display: 'flex',
    flexDirection: 'column',
    gap: '1.25rem',
  },
  inputGroup: {
    display: 'flex',
    flexDirection: 'column',
    gap: '0.5rem',
  },
  inputLabel: {
    color: '#475569',
    fontSize: '0.875rem',
    fontWeight: '600',
    display: 'flex',
    alignItems: 'center',
    gap: '0.5rem',
